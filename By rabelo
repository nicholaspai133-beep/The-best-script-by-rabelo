local EXP_CHARS=32463
local EXP_BYTES=78972
local EXP_SUM=557315134
local CORRUPT="Arquivo corrompido ao copiar (faltam ou sobram caracteres). Copie o arquivo inteiro de novo, direto do arquivo original."
local ok,err=pcall(function()
local AL="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local m={}
for i=1,64 do m[AL:byte(i)]=i-1 end
local o,n,a,bt,nc={},0,0,0,0
for i=1,#D do
local c=m[D:byte(i)]
if c then
nc=nc+1
a=a*64+c
bt=bt+6
if bt>=8 then
bt=bt-8
local p=2^bt
n=n+1
o[n]=math.floor(a/p)
a=a%p
end
end
end
if nc~=EXP_CHARS then error(CORRUPT,0) end
local r,rn,i={},0,1
while i<=n do
local f=o[i]
i=i+1
for k=0,7 do
if i>n then break end
if math.floor(f/2^k)%2==1 then
rn=rn+1
r[rn]=o[i]
i=i+1
else
local l=o[i+2]+4
local s=rn-(o[i]*256+o[i+1])
i=i+3
for j=1,l do
rn=rn+1
r[rn]=r[s+j]
end
end
end
end
if rn~=EXP_BYTES then error(CORRUPT,0) end
local sum=0
for j=1,rn do
sum=(sum*31+r[j])%1000000007
end
if sum~=EXP_SUM then error(CORRUPT,0) end
local t={}
for j=1,rn,2048 do
t[#t+1]=string.char(table.unpack(r,j,math.min(j+2047,rn)))
end
local fn,e=loadstring(table.concat(t))
if not fn then error(e,0) end
fn()
end)
if not ok then
pcall(function()
game:GetService("StarterGui"):SetCore("SendNotification",{Title="ByRabelo - erro",Text=string.sub(tostring(err),1,180),Duration=12})
end)
warn("ByRabelo: "..tostring(err))
end
